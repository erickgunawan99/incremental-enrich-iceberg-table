# Dockerfile.spark
FROM eclipse-temurin:17-jre-jammy

# Spark and Hadoop versions
ENV SPARK_VERSION=3.5.0
ENV HADOOP_VERSION=3
ENV ICEBERG_VERSION=1.4.3
ENV SCALA_VERSION=2.12
ENV HADOOP_FULL_VERSION=3.3.4
ENV AWS_SDK_VERSION=1.12.262
# Set environment variables
ENV SPARK_HOME=/opt/spark
ENV PATH=$PATH:$SPARK_HOME/bin:$SPARK_HOME/sbin
ENV PYTHONHASHSEED=1

# Install dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    python3 \
    python3-pip \
    procps \
    tini \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Download and install Spark
RUN curl -O https://archive.apache.org/dist/spark/spark-${SPARK_VERSION}/spark-${SPARK_VERSION}-bin-hadoop${HADOOP_VERSION}.tgz && \
    tar -xzf spark-${SPARK_VERSION}-bin-hadoop${HADOOP_VERSION}.tgz && \
    mv spark-${SPARK_VERSION}-bin-hadoop${HADOOP_VERSION} ${SPARK_HOME} && \
    rm spark-${SPARK_VERSION}-bin-hadoop${HADOOP_VERSION}.tgz

# Download necessary JARs for MinIO (S3) and Iceberg
WORKDIR ${SPARK_HOME}/jars

# AWS SDK for S3/MinIO support
RUN curl -O https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.3.4/hadoop-aws-3.3.4.jar && \
    curl -O https://repo1.maven.org/maven2/com/amazonaws/aws-java-sdk-bundle/1.12.262/aws-java-sdk-bundle-1.12.262.jar && \
    curl -O https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-spark-runtime-3.5_${SCALA_VERSION}/${ICEBERG_VERSION}/iceberg-spark-runtime-3.5_${SCALA_VERSION}-${ICEBERG_VERSION}.jar && \
    curl -O https://repo1.maven.org/maven2/software/amazon/awssdk/bundle/2.20.18/bundle-2.20.18.jar && \
    curl -O https://repo1.maven.org/maven2/software/amazon/awssdk/url-connection-client/2.20.18/url-connection-client-2.20.18.jar && \
    curl -O https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-aws/${ICEBERG_VERSION}/iceberg-aws-${ICEBERG_VERSION}.jar && \
    curl -O https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-common/${HADOOP_FULL_VERSION}/hadoop-common-${HADOOP_FULL_VERSION}.jar && \
    curl -O https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-auth/${HADOOP_FULL_VERSION}/hadoop-auth-${HADOOP_FULL_VERSION}.jar
# Install Python packages
RUN pip3 install --no-cache-dir\
    pyspark==${SPARK_VERSION} \
    pyarrow==14.0.1 \
    pandas==2.1.4 \
    pyiceberg==0.5.1

# Create directories
RUN mkdir -p /opt/spark/work-dir \
    /opt/spark/logs \
    /opt/spark-jobs 

# Copy spark-defaults.conf (optional)
# COPY spark-defaults.conf ${SPARK_HOME}/conf/spark-defaults.conf

WORKDIR /opt/spark/work-dir

# Expose Spark ports
EXPOSE 8080 7077 4040

# Use tini for proper signal handling
ENTRYPOINT ["/usr/bin/tini", "--"]

# Default command
CMD ["/bin/bash"]